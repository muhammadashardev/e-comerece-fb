{
	"info": {
		"_postman_id": "e-commerce-auth-collection",
		"name": "E-Commerce Auth API",
		"description": "Complete authentication and authorization APIs for the E-Commerce backend.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Signup",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\",\n    \"role\": \"user\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/signup",
							"host": ["{{baseUrl}}"],
							"path": ["signup"]
						}
					}
				},
				{
					"name": "Verify OTP",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john@example.com\",\n    \"otp\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/verify-otp",
							"host": ["{{baseUrl}}"],
							"path": ["verify-otp"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/refresh-token",
							"host": ["{{baseUrl}}"],
							"path": ["refresh-token"]
						}
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["forgot-password"]
						}
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john@example.com\",\n    \"otp\": \"123456\",\n    \"password\": \"newpassword123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["reset-password"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/logout",
							"host": ["{{baseUrl}}"],
							"path": ["logout"]
						}
					}
				}
			]
		},
		{
			"name": "Protected Routes",
			"item": [
				{
					"name": "Get Me (Profile)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/me",
							"host": ["{{baseUrl}}"],
							"path": ["me"]
						}
					}
				},
				{
					"name": "Admin Only Area",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin-only",
							"host": ["{{baseUrl}}"],
							"path": ["admin-only"]
						}
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Create Product",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "title", "value": "iPhone 15 Pro", "type": "text" },
								{ "key": "description", "value": "Next generation smartphone", "type": "text" },
								{ "key": "price", "value": "999", "type": "text" },
								{ "key": "category", "value": "Electronics", "type": "text" },
								{ "key": "stock", "value": "50", "type": "text" },
								{ "key": "rating", "value": "4.5", "type": "text" },
								{ "key": "numReviews", "value": "120", "type": "text" },
								{ "key": "image", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "http://localhost:5000/api/v1/product/createproduct",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "product", "createproduct"]
						}
					}
				}
			]
		}

	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api/v1/auth"
		},
		{
			"key": "accessToken",
			"value": ""
		}
	]
}
